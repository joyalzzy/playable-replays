{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.example/schemas/pivotal-moments-1.0.0.json",
  "title": "Pivotal esports replay moments",
  "type": "object",
  "required": ["schema_version", "source", "moments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "required": ["title", "duration_s"],
      "additionalProperties": true,
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "platform_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "caption_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "moments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/moment"},
      "contains": {
        "type": "object",
        "required": ["project_ready"],
        "properties": {"project_ready": {"const": true}}
      },
      "minContains": 1,
      "maxContains": 3
    }
  },
  "$defs": {
    "moment": {
      "type": "object",
      "required": ["id", "game_id", "title", "event_type", "project_ready", "vod", "game_time", "alignment", "transcript", "caster_context", "assessment", "evidence", "assets"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": ["project_ready"],
            "properties": {"project_ready": {"const": true}}
          },
          "then": {
            "properties": {
              "alignment": {
                "properties": {"confidence": {"enum": ["high", "medium"]}}
              },
              "assessment": {"required": ["recommended_action"]}
            }
          }
        }
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "game_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "project_ready": {"type": "boolean"},
        "vod": {
          "type": "object",
          "required": ["start_s", "decision_s", "end_s"],
          "additionalProperties": false,
          "properties": {
            "start_s": {"type": "number", "minimum": 0},
            "decision_s": {"type": "number", "exclusiveMinimum": 0},
            "end_s": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "game_time": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": true,
          "properties": {
            "start": {"type": "string", "pattern": "^[0-9]{1,2}:[0-5][0-9]$"},
            "decision": {"type": "string", "pattern": "^[0-9]{1,2}:[0-5][0-9]$"},
            "end": {"type": "string", "pattern": "^[0-9]{1,2}:[0-5][0-9]$"}
          }
        },
        "alignment": {
          "type": "object",
          "required": ["method", "confidence", "anchor_ids"],
          "additionalProperties": true,
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "confidence": {"enum": ["high", "medium", "low"]},
            "anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "transcript": {
          "type": "object",
          "required": ["source", "speaker_label", "caption_ids", "limitations"],
          "additionalProperties": true,
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "speaker_label": {"type": "string", "minLength": 1},
            "caption_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "caster_context": {
          "type": "object",
          "required": ["summary", "caption_ids"],
          "additionalProperties": true,
          "properties": {
            "summary": {"type": "string"},
            "caption_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "assessment": {
          "type": "object",
          "required": ["label", "summary", "reasoning"],
          "additionalProperties": true,
          "properties": {
            "label": {"enum": ["correct", "incorrect", "conditional", "uncertain"]},
            "summary": {"type": "string", "minLength": 1},
            "reasoning": {"type": "string", "minLength": 1},
            "better_alternative": {"type": ["string", "null"]},
            "recommended_action": {"enum": ["move", "hold", "contest", "retreat"]},
            "uncertainty": {"type": ["string", "null"]}
          }
        },
        "evidence": {
          "type": "object",
          "required": ["external_event_ids", "source_urls"],
          "additionalProperties": true,
          "properties": {
            "external_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
          }
        },
        "assets": {
          "type": "object",
          "required": ["clip", "audio", "thumbnail", "transcript_json", "transcript_srt", "transcript_text"],
          "additionalProperties": false,
          "properties": {
            "clip": {"$ref": "#/$defs/relativePath"},
            "audio": {"$ref": "#/$defs/relativePath"},
            "thumbnail": {"$ref": "#/$defs/relativePath"},
            "transcript_json": {"$ref": "#/$defs/relativePath"},
            "transcript_srt": {"$ref": "#/$defs/relativePath"},
            "transcript_text": {"$ref": "#/$defs/relativePath"}
          }
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
