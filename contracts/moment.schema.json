{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playable-replays.invalid/schemas/moment.schema.json",
  "title": "Playable replay fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "moments"],
  "properties": {
    "version": {"const": "2.1"},
    "moments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "slug", "title", "description", "map", "startTimeSeconds",
          "seed", "maxTurns", "controlledUnitId", "reasonTags", "signals", "units", "rules", "authoring"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "map": {"type": "string", "minLength": 1},
          "startTimeSeconds": {"type": "integer", "minimum": 0},
          "seed": {"type": "integer"},
          "maxTurns": {"type": "integer", "minimum": 1, "maximum": 20},
          "controlledUnitId": {"type": "string", "minLength": 1},
          "reasonTags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "signals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["winProbabilitySwing", "eventDensity", "entityProximity", "resourceAsymmetry"],
            "properties": {
              "winProbabilitySwing": {"type": "number", "minimum": 0, "maximum": 1},
              "eventDensity": {"type": "number", "minimum": 0, "maximum": 1},
              "entityProximity": {"type": "number", "minimum": 0, "maximum": 1},
              "resourceAsymmetry": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "units": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/unit"}},
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "required": ["initialAdvantage", "victory", "terrain", "referencePlan", "referenceReasons", "referenceContinuations", "actionDefaults"],
            "properties": {
              "initialAdvantage": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
              "objective": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "position", "radius", "captureTurns"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "label": {"type": "string", "minLength": 1},
                  "position": {"$ref": "#/$defs/point"},
                  "radius": {"type": "number", "exclusiveMinimum": 0},
                  "captureTurns": {"type": "integer", "minimum": 1}
                }
              },
              "victory": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "description", "defeatDescription", "allowEscape", "safeZone", "safeRadius", "escapeTurns"],
                "properties": {
                  "kind": {"type": "string", "enum": ["secure-objective", "eliminate-target", "skirmish"]},
                  "targetUnitId": {"type": "string"},
                  "description": {"type": "string", "minLength": 1},
                  "defeatDescription": {"type": "string", "minLength": 1},
                  "allowEscape": {"type": "boolean"},
                  "safeZone": {"$ref": "#/$defs/point"},
                  "safeRadius": {"type": "number", "exclusiveMinimum": 0},
                  "escapeTurns": {"type": "integer", "minimum": 1}
                }
              },
              "terrain": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "kind", "position", "radius", "moveMultiplier", "blocksVision"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "label": {"type": "string", "minLength": 1},
                    "kind": {"type": "string", "enum": ["river", "brush", "wall", "safe-zone"]},
                    "position": {"$ref": "#/$defs/point"},
                    "radius": {"type": "number", "exclusiveMinimum": 0},
                    "moveMultiplier": {"type": "number", "exclusiveMinimum": 0},
                    "blocksVision": {"type": "boolean"}
                  }
                }
              },
              "referencePlan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
              "referenceReasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "referenceContinuations": {
                "type": "object",
                "additionalProperties": false,
                "required": ["move", "hold", "contest", "retreat"],
                "properties": {
                  "move": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
                  "hold": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
                  "contest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
                  "retreat": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}}
                }
              },
              "actionDefaults": {
                "type": "object",
                "additionalProperties": false,
                "required": ["move", "hold", "contest", "retreat"],
                "properties": {
                  "move": {"$ref": "#/$defs/action"},
                  "hold": {"$ref": "#/$defs/action"},
                  "contest": {"$ref": "#/$defs/action"},
                  "retreat": {"$ref": "#/$defs/action"}
                }
              }
            }
          },
          "authoring": {"$ref": "#/$defs/authoring"}
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 100},
        "y": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["move", "hold", "contest", "retreat"]},
        "target": {"$ref": "#/$defs/point"}
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "skillLevel", "analystRationale", "intendedTradeoffs", "plausibleAlternatives", "acceptanceTests"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["objective-contest", "team-fight-engagement", "escape", "positioning", "resource-trade", "vision-uncertainty"]
        },
        "skillLevel": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
        "analystRationale": {"type": "string", "minLength": 1},
        "intendedTradeoffs": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "plausibleAlternatives": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "when", "tradeoff"],
            "properties": {
              "action": {"$ref": "#/$defs/action"},
              "when": {"type": "string", "minLength": 1},
              "tradeoff": {"type": "string", "minLength": 1}
            }
          }
        },
        "acceptanceTests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "actions", "expectedStatus", "expectedTerminalTurn", "expectedOutcomeContains"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
              "expectedStatus": {"type": "string", "enum": ["won", "lost"]},
              "expectedTerminalTurn": {"type": "integer", "minimum": 1, "maximum": 20},
              "expectedOutcomeContains": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "team", "role", "policy", "position", "hp", "maxHp", "attackRange", "attackDamage", "moveSpeed", "armor", "visionRange", "attackCooldown", "cooldownTurns", "visible", "alive"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "team": {"type": "string", "enum": ["blue", "red"]},
        "role": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "enum": ["controlled", "support", "protector", "aggressive", "skirmisher"]},
        "position": {"$ref": "#/$defs/point"},
        "hp": {"type": "integer", "minimum": 0},
        "maxHp": {"type": "integer", "minimum": 1},
        "attackRange": {"type": "number", "exclusiveMinimum": 0},
        "attackDamage": {"type": "integer", "minimum": 1},
        "moveSpeed": {"type": "number", "exclusiveMinimum": 0},
        "armor": {"type": "integer", "minimum": 0},
        "visionRange": {"type": "number", "exclusiveMinimum": 0},
        "attackCooldown": {"type": "integer", "minimum": 1},
        "cooldownTurns": {"type": "integer", "minimum": 0},
        "visible": {"type": "boolean"},
        "alive": {"type": "boolean"}
      }
    }
  }
}
