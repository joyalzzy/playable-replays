# Copy to .env for Docker Compose. Never commit real credentials.

# Browser-facing services stay loopback-only. Compose supplies service-specific
# LISTEN_ADDR and FIXTURE_PATH values; these are useful for standalone commands.
LISTEN_ADDR=127.0.0.1:8080
FIXTURE_PATH=../fixtures/moments.json
VITE_API_TARGET=http://127.0.0.1:8080

# Go -> model-daemon bot-action bridge. These three values are all-or-nothing.
# Compose uses its internal service name. For standalone `make dev-api`, override
# BOT_MODEL_URL with http://127.0.0.1:9000/v1/actions.
BOT_MODEL_URL=http://model-daemon:9000/v1/actions
BOT_MODEL_NAME=openai-npc-actions
# Keep this aligned with OPENAI_MODEL, or use another accurate rollout ID.
BOT_MODEL_VERSION=gpt-5.6

# model-daemon -> OpenAI Responses API. A blank key causes truthful non-success
# responses and deterministic Go fallback; it never creates a fake model result.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

# Keep this below the Go bridge's nine-second request deadline.
OPENAI_TIMEOUT_SECONDS=8
