# Loopback-only local development defaults.
LISTEN_ADDR=127.0.0.1:8080
FIXTURE_PATH=../fixtures/moments.json
LOCAL_DATA_DIR=../.local-data
LOCAL_DATA_RETENTION_DAYS=7
VITE_API_TARGET=http://127.0.0.1:8080

# Optional. Leave blank to use the seeded built-in non-player policy.
# When using Docker Compose, this URL must be reachable from the api container.
POSITION_MODEL_URL=
# Required when POSITION_MODEL_URL is set. Use stable rollout identifiers.
POSITION_MODEL_NAME=
POSITION_MODEL_VERSION=

# Deprecated environment-name aliases are supported as one complete group.
# Their endpoint must implement the same position-model schema 1.1:
# OPPONENT_MODEL_URL=
# OPPONENT_MODEL_NAME=
# OPPONENT_MODEL_VERSION=
# Never mix POSITION_MODEL_* and OPPONENT_MODEL_* values.
