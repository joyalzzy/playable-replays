# Copy to .env for Docker Compose. Never commit real credentials.

# Browser-facing services stay loopback-only. Compose supplies service-specific
# LISTEN_ADDR and FIXTURE_PATH values; these are useful for standalone commands.
LISTEN_ADDR=127.0.0.1:8080
FIXTURE_PATH=../fixtures/moments.json
VITE_API_TARGET=http://127.0.0.1:8080

# Go -> standalone model-service bridge. These three values are all-or-nothing.
# Compose uses its internal service name. For standalone `make dev-api`, override
# BOT_MODEL_URL with http://127.0.0.1:9000/v1/actions.
BOT_MODEL_URL=http://model:9000/v1/actions
BOT_MODEL_NAME=playable-replays-linear-unit-policy
BOT_MODEL_VERSION=unit-policy-v2-carry-safety
